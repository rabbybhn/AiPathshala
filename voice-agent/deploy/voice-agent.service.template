[Unit]
Description=ElevenLabs voice agent (__DOMAIN__)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=__APP_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=__NODE__ server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
